# Supabase Configuration
# Copy this file to .env.local and fill in your Supabase project credentials

# Required for client-side Supabase client
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Required for server-side operations (background monitoring)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Firebase Configuration (deprecated - kept for reference during migration)
# FIREBASE_PROJECT_ID=
# FIREBASE_CLIENT_EMAIL=
# FIREBASE_PRIVATE_KEY=
